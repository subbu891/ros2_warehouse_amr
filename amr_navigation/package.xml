<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_navigation</name>
  <version>1.0.0</version>
  <description>EKF, SLAM, AMCL localization, Nav2 (MPPI), costmap filters and docking configuration.</description>
  <maintainer email="subrahmanyam.kodela33@gmail.com">Subrahmanyam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>opennav_docking</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
