<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis dimensions and mass -->
  <xacro:property name="base_length" value="0.60"/>
  <xacro:property name="base_width"  value="0.45"/>
  <xacro:property name="base_height" value="0.25"/>
  <xacro:property name="base_mass"   value="20.0"/>

  <!-- Drive wheels, must match config/amr_controllers.yaml -->
  <xacro:property name="wheel_radius"     value="0.08"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_separation" value="0.50"/>
  <xacro:property name="wheel_mass"       value="1.0"/>

  <!-- Passive casters -->
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_x"      value="0.22"/>

  <!-- Lidar mounting position relative to base_link -->
  <xacro:property name="lidar_x" value="0.22"/>
  <xacro:property name="lidar_z" value="0.25"/>

  <!-- Inertia tensors of solid primitives -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0" iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}"/>
  </xacro:macro>
</robot>
