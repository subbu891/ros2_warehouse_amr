<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 360 degree 2D lidar, 10 Hz, 1 cm gaussian range noise -->
  <xacro:macro name="amr_lidar">
    <link name="laser_link">
      <visual><geometry><cylinder radius="0.05" length="0.06"/></geometry>
        <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material></visual>
      <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry></collision>
      <inertial><mass value="0.3"/><xacro:cylinder_inertia m="0.3" r="0.05" h="0.06"/></inertial>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="${lidar_x} 0 ${lidar_z}"/>
    </joint>
    <gazebo reference="laser_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>laser_link</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>20.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- IMU at 50 Hz, the EKF uses its yaw rate -->
  <xacro:macro name="amr_imu">
    <link name="imu_link">
      <inertial><mass value="0.05"/><xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.01"/></inertial>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.1"/>
    </joint>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity><z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x></linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Optional RGB-D camera, disabled by default to keep the simulation fast -->
  <xacro:macro name="amr_camera">
    <link name="camera_link">
      <visual><geometry><box size="0.03 0.1 0.03"/></geometry></visual>
      <inertial><mass value="0.1"/><xacro:box_inertia m="0.1" x="0.03" y="0.1" z="0.03"/></inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.3 0 0.18"/>
    </joint>
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="camera_link">
      <sensor name="rgbd" type="rgbd_camera">
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <topic>camera</topic>
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.1</near><far>8.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
