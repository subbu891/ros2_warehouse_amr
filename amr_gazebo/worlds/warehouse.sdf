<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>10.0 -0.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>10.0 14.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-0.1 7.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>20.1 7.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_1">
      <static>true</static>
      <pose>8.0 4.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 1.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.2 0.35 0.8 1</ambient><diffuse>0.2 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>8.0 7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 1.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.2 0.35 0.8 1</ambient><diffuse>0.2 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>8.0 10.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 1.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.2 0.35 0.8 1</ambient><diffuse>0.2 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>15.0 7.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="office">
      <static>true</static>
      <pose>17.5 12.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 3.6 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 3.6 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pallets">
      <static>true</static>
      <pose>14.5 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="charger_dock">
      <static>true</static>
      <pose>0.25 2.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.6 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.6 0.4</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="forklift">
      <pose>13.0 1.5 0.76 0 0 0</pose>
      <link name="link">
        <inertial><mass>200</mass>
          <inertia><ixx>50</ixx><iyy>50</iyy><izz>50</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>1.2 0.8 1.5</size></box></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 1.5</size></box></geometry>
          <material><ambient>1 0.55 0 1</ambient><diffuse>1 0.55 0 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>10</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
